{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dársena",
  "mainBinaryName": "darsena",
  "version": "0.1.16",
  "identifier": "com.darsena.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dársena",
        "visible": false,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#171a21"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: cover: http://cover.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; frame-src https://www.youtube-nocookie.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "theolivander97",
    "shortDescription": "Launcher de juegos porteados"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxMUJFRDBDQjNFRUE5NUYKUldSZnFlNnpETzBiVVdaQ2JkOWwwN2pGelQ1MTRTMkhTM0FPcWVuSnAwZG52TldVR3REZ2xEVlQK",
      "endpoints": [
        "https://github.com/theolivander97/darsena-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
